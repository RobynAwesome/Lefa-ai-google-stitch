# GEMINI_API_KEY: Required only for Gemini AI API calls handled by the trusted runtime.
# AI Studio can inject this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_LEFA_SOVEREIGN_STATUS_URL: Read-only LEFA bridge-status endpoint.
# This endpoint MUST expose a validated `kopano.lefa.sovereign-bridge-status.v1`
# response for Alpaca PAPER only. Never place Alpaca API keys or secrets in VITE_*
# variables: Vite variables are browser-visible by design.
VITE_LEFA_SOVEREIGN_STATUS_URL=""
